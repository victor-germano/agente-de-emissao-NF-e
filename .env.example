# Porta do servidor HTTP
PORT=3000

# URL para onde o App VYX seria notificado ("nota disponivel").
# Em producao isso seria o endpoint real do app; aqui e mockado.
APP_NOTIFICATION_WEBHOOK_URL=http://localhost:3000/mock/app-webhook

# Configuracao do mock da Prefeitura de Marilia (para simular falhas em testes)
NFSE_MOCK_FAILURE_RATE=0
NFSE_MOCK_LATENCY_MS=150

# Simula o token de acesso da Focus NFe (pesquisado, nao suposto): API real usa HTTP
# Basic Auth com o token da empresa como "usuario" e senha em branco, ambiente de
# homologacao gratis/ilimitado em homologacao.focusnfe.com.br, producao em
# api.focusnfe.com.br (ver doc.focusnfe.com.br/reference/autenticacao e README secao
# "Integracao com a Prefeitura de Marilia"). Vazio = checagem pulada (comportamento
# atual, sem exigir token). O unico valor "valido" no mock e sandbox_focusnfe_demo_2026
# (ver SIMULATED_VALID_API_TOKEN); qualquer outro valor falha com 401 simulado — util
# pra testar o que acontece com uma chave invalida/expirada.
NFSE_API_TOKEN=

# Numero de tentativas e backoff da emissao da NFS-e
NFSE_RETRY_MAX_ATTEMPTS=3
NFSE_RETRY_BASE_DELAY_MS=200

# Limite (ms) de pagamento->nota emitida acima do qual dispara alerta de SLA
# (severidade "warning" - a nota saiu, so demorou mais que o esperado). Consultavel via
# GET /alerts. Cada invoice ja guarda emissionDurationMs; este e so o limiar de alerta.
EMISSION_SLA_MS=5000

# Projeto Supabase real criado para este agente (schema ja aplicado: patients,
# doctors, consultations, invoices, invoice_audit_log). Preenchendo as duas
# variaveis, o app troca automaticamente as implementacoes in-memory pelas
# reais (ver README). SUPABASE_URL nao e secreta; SUPABASE_SERVICE_ROLE_KEY e
# secreta e precisa ser copiada manualmente do dashboard (Project Settings >
# API > service_role) — nao e obtida por automacao por seguranca.
SUPABASE_URL=https://nlyiesaskjvwiwdgscxl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Segredos para validar a origem dos webhooks. Se vazios, a checagem correspondente
# e pulada (conveniente para rodar o painel local/demo sem assinar requisicoes).
STRIPE_WEBHOOK_SECRET=
GATEWAY2_WEBHOOK_SECRET=

# Protege GET/POST de consulta e operacao (/invoices, /alerts, /metrics, /debug/*,
# /reconciliation/*) exigindo "Authorization: Bearer <valor>". Se vazio, esses
# endpoints ficam abertos — conveniente para o painel local/demo, mas em producao
# deve ser preenchido (ha dados de paciente nessas rotas).
ADMIN_API_KEY=

# Recuperacao de notas travadas em "processing" (crash-safety)
STUCK_INVOICE_THRESHOLD_MS=60000
RECOVERY_SWEEP_INTERVAL_MS=60000

# Intervalo da reconciliacao periodica (Stripe x notas emitidas)
RECONCILIATION_INTERVAL_MS=120000

# NODE_ENV=production desabilita as rotas /debug/* (nao tem motivo pra existir
# fora de ambiente local/teste). Deixe vazio/development para uso local.
NODE_ENV=development
