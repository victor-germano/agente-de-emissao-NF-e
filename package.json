{
  "name": "vyx-nf-agent",
  "version": "0.1.0",
  "description": "Agente de automacao para emissao de notas fiscais - VYX",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
